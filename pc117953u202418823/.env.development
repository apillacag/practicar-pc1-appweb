# Environment: Development
# Description: Environment variables used during development (npm run dev).
# Note: In real-world scenarios this file would not be committed to the repository.

# VITE_PRESIDENTS_API_URL is the base URL for the Sample APIs presidents provider.
VITE_PRESIDENTS_API_URL="https://api.sampleapis.com/presidents"
# VITE_PRESIDENTS_ENDPOINT_PATH is the path to the presidents collection endpoint.
VITE_PRESIDENTS_ENDPOINT_PATH="/presidents"
# VITE_LOGO_API_URL is the base URL for the Logo.dev API.
VITE_LOGO_API_URL="https://img.logo.dev"
# VITE_LOGO_PUBLISHABLE_API_KEY is the publishable API key for the Logo.dev API.
VITE_LOGO_PUBLISHABLE_API_KEY="pk_H1j_uA9GRFizL2ikMw4qwQ"
# VITE_WIKIPEDIA_DOMAIN is the domain used to resolve the Wikipedia logo via Logo.dev.
VITE_WIKIPEDIA_DOMAIN="wikipedia.org"
# VITE_PRIME_UI_LICENSE_KEY is the license key for the Prime UI component library.
